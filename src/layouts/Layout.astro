---
import '../styles/global.css'

import { getCitta } from '../lib/data'

const citta = getCitta()
const cittaInEvidenza = citta.slice(0,4)


interface Props {
    title: string
    description?: string
}

const { title, description = "Scopri le aziende IT della Romagna. Trova stage e opportunità di lavoro nel settore tecnologico" } = Astro.props
---

<!DOCTYPE html>
<html lang="it" class="bg-background">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet" />
    <title>{title} | IT Romagna</title>
</head>
    <body class="min-h-screen flex flex-col font-sans antialiased">
        <header class="sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
            <div class="container mx-auto h-16 grid grid-cols-3 items-center">
                <a href="/" class="flex items-center gap-2 justify-self-start">
                    <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
                        <span class="text-primary-foreground font-bold text-sm">IT</span>
                    </div>
                    <span class="font-bold text-xl text-foreground">IT Romagna</span>
                </a>

                <nav class="hidden md:flex items-center gap-6 justify-self-center">
                    <a href="/" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">
                        Home
                    </a>
                    <a href="/aziende" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">
                        Aziende
                    </a>
                    <a href="/" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">
                        Contatti
                    </a>
                </nav>

                <!-- <div class="flex items-center gap-3">
                    <a 
                        href="/login"
                        class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
                    >
                        Accedi
                    </a>
                    <a 
                        href="/registrati"
                        class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow hover:bg-primary/90 transition-colors"
                    >
                        Registrati
                    </a>
                </div> -->
                <div class="flex h-16 items-center justify-self-end">
                    <div class="flex items-center gap-3 m-0.5 hover">
                        <a 
                            href="/login"
                            class="inline-flex items-center justify-center rounded-md bg-gradient-to-r from-primary to-secondary px-4 py-2 text-sm font-medium text-primary-foreground shadow hover:opacity-50 transition-opacity"
                        >
                            Accedi
                        </a>
                    </div>
                    <div class="flex items-center gap-3 m-0.5">
                        <a 
                            href="/registra"
                            class="inline-flex items-center justify-center rounded-md bg-gradient-to-l from-primary to-secondary px-4 py-2 text-sm font-medium text-primary-foreground shadow hover:opacity-50 transition-opacity"
                        >
                            Registra la tua azienda
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <main class="flex-1">
            <slot />
        </main>

        <footer class="border-t border-border bg-muted/30">
            <div class="container mx-auto px-4 py-12">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                    <div class="space-y-4">
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
                                <span class="text-primary-foreground font-bold text-sm">IT</span>
                            </div>
                            <span class="font-bold text-lg">IT Romagna</span>
                        </div>
                        <p class="text-sm text-muted-foreground">
                            Il portale delle aziende IT della Romagna.
                        </p>
                    </div>

                    <div>
                        <h3 class="font-semibold mb-4">Navigazione</h3>
                        <ul class="space-y-2 text-sm text-muted-foreground">
                            <li><a href="/" class="hover:text-foreground transition-colors">Home</a></li>
                            <li><a href="/aziende" class="hover:text-foreground transition-colors">Esplora Aziende</a></li>
                            <li><a href="/contatti" class="hover:text-foreground transition-colors">Contatti</a></li>
                        </ul>
                    </div>

                    <div>
                        <h3 class="font-semibold mb-4">Città</h3>
                        <ul class="space-y-2 text-sm text-muted-foreground">
                            {cittaInEvidenza.map(c => (
                                <li>
                                    <a 
                                        href={`/aziende?citta=${c.id}`}
                                        class="hover:text-foreground transition-colors"
                                    >
                                        {c.nome}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <div>
                        <h3 class="font-semibold mb-4">In collaborazione con il DIR</h3>
                        <a 
                            href="https://www.distrettodellinformaticaromagnolo.org/"
                            class="space-y-2 text-sm text-muted-foreground hover:text-foreground transition-colors"
                        >
                            Sito DIR
                        </a>
                    </div>
                </div>

                <div class="mt-12 pt-8 border-t border-border flex flex-col md:flex-row justify-between items-center gap-4">
                    <p class="text-sm text-muted-foreground">
                        &copy; 2026 IT Romagna. Tutti i diritti riservati.
                    </p>
                    <div class="flex gap-4 text-sm text-muted-foreground">
                        <a href="/privacy" class="hover:text-foreground transition-colors">Privacy Policy</a>
                        <a href="/termini" class="hover:text-foreground transition-colors">Termini di Servizio</a>
                    </div>
                </div>
            </div>
        </footer>
    </body>
</html>
