---
import Layout from "../../layouts/Layout.astro";
import AziendaCard from "../../components/AziendaCard.astro";
import { getAziende, getCitta, getAmbiti } from "../../lib/data";

const url = new URL(Astro.request.url)
const searchQuery = url.searchParams.get('q') || ''
const cittaFilter = url.searchParams.getAll('citta')
const ambitoFilter = url.searchParams.getAll('ambito')

let aziendeFiltrate = [...getAziende().filter(a => a.da_verificare === true)]

if (searchQuery) {
    const query = searchQuery.toLowerCase()
    aziendeFiltrate = aziendeFiltrate.filter(a => 
        a.nome.toLowerCase().includes(query) ||
        a.descrizione.toLowerCase().includes(query)
    )
}

if (cittaFilter.length > 0) {
    aziendeFiltrate = aziendeFiltrate.filter(a => cittaFilter.includes(a.id_citta))
}

if (ambitoFilter.length > 0) {
    aziendeFiltrate = aziendeFiltrate.filter(a => 
        a.ambiti.some(amb => ambitoFilter.includes(amb))
    )
}

const hasFilters = searchQuery || cittaFilter.length > 0 || ambitoFilter.length > 0

console.log('URL:', Astro.request.url)
console.log('searchQuery:', searchQuery)
console.log('cittaFilter:', cittaFilter)
console.log('ambitoFilter:', ambitoFilter)
---

<Layout title="Tutte le aziende" description="Esplora tutte le aziende IT della Romagna. Filtra per citta o ambito di lavoro">
    <div class="container mx-auto px-4 py-8">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-foreground mb-2">Esplora le Aziende</h1>
            <p class="text-muted-foreground">
                {aziendeFiltrate.length} aziende trovate {hasFilters && '(con filtri attivi)'}
            </p>
        </div>

        <div class="flex flex-col lg:flex-row gap-8">
        <!-- Barra dei filtri laterale -->
            <aside class="lg:w-72 shrink-0">
                <form method="get" class="bg-card rounded-xl border border-border p-6 sticky top-24">
                    <div class="flex-items-center justify-between mb-6">
                        <h2 class="font-semibold text-foreground">Filtri</h2>
                        {hasFilters && (
                            <a href="/aziende" class="text-sm text-primary hover:underline">
                                Rimuovi tutti
                            </a>
                        )}
                    </div>

                    <!-- Ricerca -->
                    <div class="mb-6">
                        <label for="search" class="block text-sm font-medium text-foreground mb-2">Ricerca</label>
                        <input 
                            type="text"
                            id="search"
                            name="q"
                            value={searchQuery}
                            placeholder="Nome azienda..."
                            class="w-full h-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring text-sm"
                        >
                    </div>

                    <!-- Citta -->
                    <div class="mb-6">
                        <h3 class="text-sm font-medium text-foreground mb-3">Città</h3>
                        <div class="space-y-2 max-h-48 overflow-y-auto">
                            {getCitta().map(c => (
                                <label class="flex items-center gap-2 cursor-pointer">
                                    <input 
                                        type="checkbox"
                                        name="citta"
                                        value={c.id}
                                        checked={cittaFilter.includes(c.id)}
                                        class="w-4 h-4 rounded border-input text-primary focus:ring-primary"
                                    />
                                    <span class="text-sm text-muted-foreground">{c.nome}</span>
                                </label>
                            ))}
                        </div>
                    </div>

                    <!-- Ambiti -->
                    <div class="mb-6">
                        <h3 class="text-sm font-medium text-foreground mb-3">Ambito di Lavoro</h3>
                        <div class="space-y-2 max-h-48 overflow-y-auto">
                            {getAmbiti().map(a => (
                                <label class="flex items-center gap-2 cursor-pointer">
                                    <input 
                                        type="checkbox"
                                        name="ambito"
                                        value={a.id}
                                        checked={ambitoFilter.includes(a.id)}
                                        class="w-4 h-4 rounded border-input text-primary focus:ring-primary"
                                    />
                                    {a.nome}
                                </label>
                            ))}
                        </div>
                    </div>

                    <button
                        type="submit"
                        class="w-full h-10 bg-primary text-primary-foreground font-medium rounded-lg hover:bg-primary/90 transition-colors"
                    >
                        Applica Filtri    
                    </button>
                </form>
            </aside>

            <!-- Aziende risultato ricerca -->
            <div class="flex-1">
                {aziendeFiltrate.length > 0 ? (
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        {aziendeFiltrate.map(a => (
                            <AziendaCard azienda={a} />
                        ))}
                    </div>
                ) : (
                    <div class="text-center py-16">
                        <div class="w-16 h-16 bg-muted rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                        </div>
                        <h3 class="text-lg font-semibold text-foreground mb-2">Nessuna azienda da verificare</h3>
                        <p class="text-muted-foreground mb-4">Prova a modificare i filtri di ricerca</p>
                        <a href="/aziende" class="text-primary hover:underline">Rimuovi tutti i filtri</a>
                    </div>
                )}
            </div>
        </div>
    </div>
</Layout>