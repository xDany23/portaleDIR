---
import Layout from "../../layouts/Layout.astro";
import { getAmbitoById, getCittaById, slugify } from "../../lib/data";

const azienda = Astro.locals.azienda!
---

<Layout title={`Dashboard - ${azienda.nome}`}>
    <section class="max-w-5xl mx-auto py-12 px-4">

        <!-- Header iniziale -->
        <div class="flex items-center justify-between mb-10">
            <div>
                <h1 class="text-3xl font-bold text-foreground">Dashboard</h1>
                <p class="text-muted-foreground mt-1">Gestisci il profilo della tua azienda</p>
            </div>

            <form action="/api/logout" method="POST">
                <button class="px-4 py-2 rounded-lg bg-destructive text-destructive-foreground hover:bg-destructive/70 transition cursor-pointer">
                    Logout
                </button>
            </form>
        </div>

        <!-- Dati azienda -->
        <div class="bg-card border border-border rounded-xl p-6 shadow-sm mb-10">
            <h2 class="text-xl font-semibold mb-4">Informazioni dell'azienda</h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                <p><span class="font-medium">Email:</span> {azienda.email_contatto}</p>
                <p><span class="font-medium">Città:</span> {getCittaById(azienda.id_citta)}</p>
                <p><span class="font-medium">Dimensione:</span> {azienda.dimensione}</p>
                <p><span class="font-medium">Remoto:</span> {azienda.lavoro_da_remoto}</p>
                <p class="sm:col-span-2">
                    <span class="font-medium">Ambiti:</span> {azienda.ambiti.map(id => getAmbitoById(id)?.nome ?? "Sconosciuto").join(", ")}
                </p>
            </div>
        </div>

        <!-- Form per la modifica -->
        <div class="bg-card border border-border rounded-xl p-6 shadow-sm">
            <h2 class="text-xl font-semibold mb-6">Modifica profilo</h2>

            <form action="/api/update-azienda" method="POST" enctype="multipart/form-data" class="space-y-6">
                <input type="hidden" name="slug" value={slugify(azienda.nome)} />

                <div class="space-y-2">
                    <label class="text-sm font-medium">Nome azienda</label>
                    <input 
                        type="text" 
                        name="nome" 
                        value={azienda.nome} 
                        class="w-full h-10 px-3 rounded-lg border border-input bg-background text-foreground focus:ring-2 focus:ring-ring focus:outline-none"
                    />
                </div>

                <div class="space-y-2">
                    <label class="text-sm font-medium">Descrizione</label>
                    <textarea 
                        name="descrizione" 
                        rows="4" 
                        class="w-full px-3 py-2 rounded-lg border border-input bg-background text-foreground focus:ring-2 focus:ring-ring focus:outline-none"
                    >{azienda.descrizione}</textarea>
                </div>

                <div class="space-y-2">
                    <label class="text-sm font-medium">Logo (opzionale)</label>
                    <input 
                        type="file" 
                        name="logo" 
                        class="w-full h-10 px-3 rounded-lg border border-input bg-background text-foreground focus:ring-2 focus:ring-ring focus:outline-none mt-1"
                    />
                </div>

                <button class="px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition">
                    Salva modifiche
                </button>
            </form>
        </div>

    </section>
</Layout>