---
import { getAziende, getAziendaById, getAziendeByFilters, getAmbiti } from "../lib/data";
import Layout from "../layouts/Layout.astro";

const ambiti = await getAmbiti()
const aziende = await getAziende()
const aziendeInEvidenza = aziende.slice(0, 3)

---

<Layout title="Homepage">
	<!-- Hero -->
  <section class="section py-28 text-center">
    <h1 class="text-5xl md:text-6xl font-bold tracking-tight">
      Trova aziende IT in Romagna
    </h1>

    <p class="mt-6 text-lg text-gray-600 max-w-2xl max-auto">
      Esplora le aziende del Distretto dell’Informatica Romagnola, filtra per città, ambito e opportunità di tirocinio.
    </p>

    <div class="mt-10 max-w-xl mx-auto">
      <input type="text" placeholder="Cerca un'azienda..." class="input shadow-sm" />
    </div>

	<!-- Ambiti -->
	 <section class="section-light">
		<div class="section">
			<h2 class="mb-8 text-center">Ambiti IT</h2>

			<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
				{ambiti.map(a => (
					<div class="card p-5 text-center hover:shadow-sm">
						<span class="font-medium">{a.nome}</span>
					</div>
				))}
			</div>
		</div>
	 </section>

	 <!-- Aziende in evidenza -->
	<section class="section">
		<h2 class="mb-8 text-center">Aziende in evidenza</h2>

		<div class="grid-cards">
			{aziendeInEvidenza.map(a => (
				<a href={'/aziende/${a.slug}'} class="card hover:shadow-md transition-shadow">
					<h3>{a.nome}</h3>
					<p class="text-sm text-gray-600 mt-2">{a.descrizione}</p>
				</a>
			))}
		</div>
	</section>

	<!-- Cta -->
	<section class="bg-emerald-600 text-white py-16">
		<div class="section text-center">
			<h2 class="text-3xl font-semibold">Sei un'azienda IT?</h2>
			<p class="mt-4 text-lg opacity-90">
				Entra nel portale e fatti trovare da studenti e neolaureati.
			</p>

			<a href="/per-le-aziende" class="btn-primary mt-8 inline-block">Registrati ora</a>
		</div>
	</section>
	
</Layout>
