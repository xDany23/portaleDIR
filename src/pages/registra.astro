---
import Layout from "../layouts/Layout.astro";
import { getCitta, getAmbiti } from "../lib/data";
---

<Layout title="Registra Azienda">
    <div class="py-12 px-4">
        <div class="max-w-2xl mx-auto">
            <div class="text-center mb-8">
                <h1 class="text-3xl font-bold text-foreground mb-2">Registra la tua Azienda</h1>
                <p class="text-muted-foreground">Compila il form per aggiungere la tua azienda al portale</p>
            </div>

            <div class="bg-card rounded-xl border border-border p-8">
                <div id="errore" class="hidden p-4 mb-4 rounded-lg bg-destructive-foreground text-destructive border border-accent">

                </div>
                <form id="form-registrazione" class="space-y-6" enctype="multipart/form-data" novalidate>
                    <!-- Info dell'Account aziendale -->
                    <div class="space-y-4">
                        <h2 class="text-lg font-semibold text-foreground border-b border-border pb-2">Informazioni Account</h2>
                        <div>
                            <label for="email" class="block text-sm font-medium text-foreground mb-2">
                                Email Aziendale *
                            </label>
                            <input 
                                type="email"
                                id="email"
                                name="email"
                                required
                                class="w-full h-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none"
                                placeholder="info@azienda.it"
                            />
                            <p class="text-sm text-destructive mt-1 hidden" data-error></p>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label for="password" class="block text-sm font-medium text-foreground mb-2">
                                    Password *
                                </label>
                                <input 
                                    type="password"
                                    id="password"
                                    name="password"
                                    required
                                    minlength="8"
                                    class="w-full h-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2"
                                />
                                <p class="text-sm text-destructive mt-1 hidden" data-error></p>
                                <div id="password-strength" class="mt-2 h-2 w-full bg-muted rounded overflow-hidden">
                                    <div id="password-bar" class="h-full w-0 transition-all duration-300"></div>
                                </div>

                                <p id="password-strength-text" class="text-sm mt-1 text-muted-foreground"></p>

                            </div>
                            <div>
                                <label for="password-confirm" class="block text-sm font-medium text-foreground mb-2">
                                    Conferma Password *
                                </label>
                                <input 
                                    type="password"
                                    id="password-confirm"
                                    name="password-confirm"
                                    required
                                    class="w-full h-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2"
                                />
                                <p class="text-sm text-destructive mt-1 hidden" data-error></p>
                            </div>
                        </div>
                    </div>

                    <!-- Informazioni dell'Azienda -->
                    <div class="space-y-4">
                        <h2 class="text-lg font-semibold text-foreground border-b border-border pb-2">Informazioni Azienda</h2>

                        <div>
                            <label for="nome" class="block text-sm font-medium text-foreground mb-2">
                                Nome Azienda *
                            </label>
                            <input 
                                type="text"
                                id="nome"
                                name="nome"
                                required
                                class="w-full h-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
                                placeholder="Nome della tua azienda"
                            />
                            <p class="text-sm text-destructive mt-1 hidden" data-error></p>
                        </div>

                        <div>
                            <label for="descrizione" class="block text-sm font-medium text-foreground mb-2">
                                Descrizione *
                            </label>
                                <textarea 
                                    name="descrizione" 
                                    id="descrizione"
                                    required
                                    rows="4"
                                    class="w-full px-3 py-2 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring resize-none"
                                    placeholder="Descrizi la tua azienda, cosa fate, le tecnologie che usate..."
                                ></textarea>
                                <p class="text-sm text-destructive mt-1 hidden" data-error></p>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label for="citta" class="block text-sm font-medium text-foreground mb-2">
                                    Citta *
                                </label>
                                <select 
                                    name="citta" 
                                    id="citta"
                                    required
                                    class="w-full h-10 px-3 rounded-lg border border-input bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
                                >
                                <option value="">Seleziona citta</option>
                                {getCitta().map(c => (
                                    <option value={c.id}>{c.nome}</option>
                                ))}
                                </select>
                                <p class="text-sm text-destructive mt-1 hidden" data-error></p>
                            </div>

                            <div>
                                <label for="dimensione" class="block text-sm font-medium text-foreground mb-2">
                                    Dimensione *
                                </label>
                                <input 
                                    type="text"
                                    id="dimensione"
                                    name="dimensione"
                                    required
                                    class="w-full h-10 px-3 rounded-lg border border-input bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
                                    placeholder="Startup / PMI / Grande Azienda"
                                />
                                <p class="text-sm text-destructive mt-1 hidden" data-error></p>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-foreground mb-2">
                                Lavoro da Remoto *
                            </label>
                            <div class="flex gap-4">
                                <input 
                                    type="text"
                                    id="remoto"
                                    name="remoto"
                                    required
                                    class="w-full h-10 px-3 rounded-lg border border-input bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
                                    placeholder="Sì / No / Ibrido"
                                />
                                <p class="text-sm text-destructive mt-1 hidden" data-error></p>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-foreground mb-2">
                                Ambiti di Lavoro *
                            </label>
                            <div class="grid grid-cols-2 gap-2">
                                {getAmbiti().map(a => (
                                    <label class="flex items-center gap-2 cursor-pointer">
                                        <input 
                                            type="checkbox"
                                            name="ambiti"
                                            value={a.id}
                                            class="w-4 h-4 rounded cursor-pointer"
                                        />
                                        <span class="text-sm text-muted-foreground">{a.nome}</span>
                                    </label>
                                ))}
                                <p class="text-sm text-destructive mt-1 hidden" data-error></p>
                            </div>
                        </div>
                    </div>

                    <!-- Informazioni sui Contatti (Opzionale) -->
                    <div class="space-y-4">
                        <h2 class="text-lg font-semibold text-foreground border-b border-border pb-2">Contatti (Opzionali)</h2>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label for="telefono" class="block text-sm font-medium text-foreground mb-2">
                                    Telefono
                                </label>
                                <input 
                                    type="tel"
                                    id="telefono"
                                    name="telefono"
                                    class="w-full h-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-rin"
                                    placeholder="+39"
                                />
                            </div>
                            <div>
                                <label for="sito" class="block text-sm font-medium text-foreground mb-2">
                                    Sito Web
                                </label>
                                <input 
                                    type="url"
                                    id="sito"
                                    name="sito"
                                    class="w-full h-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
                                    placeholder="https://"
                                />
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label for="indirizzo" class="block text-sm font-medium text-foreground mb-2">
                                    Indirizzo
                                </label>
                                <input 
                                    type="text"
                                    id="indirizzo"
                                    name="indirizzo"
                                    class="w-full h-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
                                    placeholder="Via Roma 123, Cesena"
                                />
                            </div>

                            <div>
                                <label for="logo" class="block text-sm font-medium text-foreground mb-2">
                                    Logo
                                </label>
                                <input 
                                    type="file"
                                    id="logo"
                                    name="logo"
                                    accept="image/*"
                                    class="w-full h-10 px-3 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
                                />
                            </div>
                        </div>

                    </div>

                    <!-- Termini -->
                    <label class="flex items-start gap-2 cursor-pointer">
                        <input 
                            type="checkbox"
                            name="privacy"
                            required
                            class="w-4 h-4 rounded border-input mt-0.5 cursor-pointer"
                        />
                        <span class="text-sm text-muted-foreground">
                            Accetto la <a href="/privacy" class="text-primary hover:underline">Privacy Policy</a> e i <a href="/termini" class="text-primary hover:underline">Termini di Servizio</a>
                        </span>
                    </label>

                    <button
                        type="submit"
                        class="w-full h-12 bg-primary text-primary-foreground font-medium rounded-lg hover:bg-primary/90 transition-colors cursor-pointer"
                    >
                        Registra Azienda
                    </button>
                </form>

                <div class="mt-6 text-center">
                    <p class="text-sm text-muted-foreground">
                        Hai già un account aziendale?
                        <a href="/login" class="text-primary hover:underline ml-1">Accedi</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {

        const boxErrore = document.getElementById('errore') as HTMLDivElement
        const form = document.getElementById('form-registrazione')
        const pass = document.getElementById('password') as HTMLInputElement
        const conferma = document.getElementById('password-confirm') as HTMLInputElement
        const email = document.getElementById('email') as HTMLInputElement

        const nome = document.getElementById('nome') as HTMLInputElement
        const descrizione = document.getElementById('descrizione') as HTMLTextAreaElement
        const citta = document.getElementById('citta') as HTMLSelectElement
        const dimensione = document.getElementById('dimensione') as HTMLInputElement
        const remoto = document.getElementById('remoto') as HTMLInputElement

        //validazione in tempo reale
        /* email.addEventListener("input", () => {
            validaCampo(email, email.value.includes("@"), "Inserisci un'email valida")
        }) */

        pass.addEventListener("input", () => {
            aggiornaBarraPassword(pass.value)

            const maiuscola = /[A-Z]/.test(pass.value)
            const speciale = /[!@#$%^&*(),.?":{}|<>]/.test(pass.value)
            const numero = /[0-9]/.test(pass.value)
            const lunghezza = pass.value.length > 8

            if (!lunghezza) {
                validaCampo(pass, false, "Minimo 8 caratteri")
            } else if (!maiuscola) {
                validaCampo(pass, false, "Serve almeno una lettera maiuscola")
            } else if (!numero) {
                validaCampo(pass, false, "Serve almeno un numero")
            } else if (!speciale) {
                validaCampo(pass, false, "Serve almeno un carattere speciale")
            } else {
                validaCampo(pass, true, "")
            }
        })

        conferma.addEventListener("input", () => {
            validaCampo(conferma, conferma.value === pass.value, "Le password non coincidono")
        })

        /* nome.addEventListener("input", () => {
            validaCampo(nome, nome.value.trim().length > 0, "Il nome è obbligatorio")
        }) */

        /* descrizione.addEventListener("input", () => {
            validaCampo(descrizione, descrizione.value.trim().length > 0, "La descrizione è obbligatoria")
        }) */

        /* citta.addEventListener("change", () => {
            validaCampo(citta, citta.value.trim().length > 0, "Seleziona una città")
        }) */

        //funzione
        function validaCampo(
            input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement, 
            condizione: boolean, 
            messaggio: string
        ): boolean {

            const errore = input.parentElement!.querySelector("[data-error]") as HTMLParagraphElement

            if (condizione) {
                input.classList.remove("focus:ring-red-500")
                input.classList.remove("border-red-500")
                input.classList.add("focus:ring-green-500")
                input.classList.add("border-green-500")
                errore.classList.add("hidden")
                errore.textContent = ""
                return true
            } else {
                input.classList.remove("focus:ring-green-500")
                input.classList.remove("border-green-500")
                input.classList.add("focus:ring-red-500")
                input.classList.add("border-red-500")
                errore.classList.remove("hidden")
                errore.textContent = messaggio
                return false
            }
        }

        function calcolaForzaPassword(password: string) {
            let forza = 0

            if (password.length >= 8) forza++
            if (/[A-Z]/.test(password)) forza++
            if (/[0-9]/.test(password)) forza++
            if (/[!@#$%^&*(),.?":{}|<>]/.test(password)) forza++

            return forza
        }

        function aggiornaBarraPassword(password: string) {
            const forza = calcolaForzaPassword(password)
            const bar = document.getElementById("password-bar") as HTMLDivElement
            const text = document.getElementById("password-strength-text") as HTMLParagraphElement

            let width = "0%"
            let color = "bg-red-500"
            let label = "Debole"

            switch (forza) {
                case 1:
                    width = "25%"
                    color = "bg-red-500"
                    label = "Molto debole"
                    break
                case 2:
                    width = "50%"
                    color = "bg-orange-500"
                    label = "Debole"
                    break
                case 3:
                    width = "75%"
                    color = "bg-yellow-500"
                    label = "Buona"
                    break
                case 4:
                    width = "100%"
                    color = "bg-green-500"
                    label = "Forte"
                    break
            }

            //reset del colore delle classi
            bar.className = "h-full transition-all duration-300 " + color
            bar.style.width = width

            text.textContent = label
        }

        //validazione al submit
        form?.addEventListener('submit', async (e) => {
            e.preventDefault()

            const errori: string[] = []

            //validazioni

            //email
            if (!email?.value.trim()) errori.push("L'email è obbligatoria")
            const emailPassabile = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)
            if (!emailPassabile) errori.push("Email non accettabile")
            if (!pass?.value.trim()) errori.push("La password è obbligatoria")
            if (!conferma?.value.trim()) errori.push("La password di conferma è obbligatoria")
            if (!nome?.value.trim()) errori.push("Il nome dell'azienda è obbligatorio")
            if (!descrizione?.value.trim()) errori.push("La descrizione è obbligatoria")
            if (!citta?.value.trim()) errori.push("La città è obbligatoria")
            if (!dimensione?.value.trim()) errori.push("La dimensione è obbligatoria")
            if (!remoto?.value.trim()) errori.push("Il campo 'Lavoro da remoto' è obbligatorio")

            //ambiti
            const ambiti = Array.from(document.querySelectorAll("input[name='ambiti']:checked"))
            if (ambiti.length === 0) errori.push("Seleziona almeno un ambito di lavoro")

            //password
            const maiuscola = /[A-Z]/.test(pass.value)
            const speciale = /[!@#$%^&*(),.?":{}|<>]/.test(pass.value)
            const numero = /[0-9]/.test(pass.value)
            if (pass.value.length < 8) errori.push("La password deve avere almeno 8 caratteri")
            if (!maiuscola) errori.push("La password deve contenere almeno una lettera maiuscola")
            if (!numero) errori.push("La password deve contenere almeno un numero")
            if (!speciale) errori.push("La password deve contenere almeno un carattere speciale")

            if (pass.value !== conferma.value) errori.push("Le password non coincidono")

            //in caso di errori li mostro
            if (errori.length > 0) {
                boxErrore.innerHTML = errori[0]
                boxErrore.classList.remove('hidden')

                window.scrollTo({ top: 0, behavior: "smooth" })

                return
            }

            //altrimenti invio tutto al server
            const formData = new FormData(e.target as HTMLFormElement)

            const response = await fetch('/api/registra-azienda', {
                method: 'POST',
                body: formData
            })

            const data = await response.json()

            if (data.success) {
                window.location.href = '/'
                alert('Azienda registrata con successo!')
            } else {
                boxErrore!.textContent = data.error
                boxErrore!.classList.remove('hidden')
                return
            }
        })
    })
</script>